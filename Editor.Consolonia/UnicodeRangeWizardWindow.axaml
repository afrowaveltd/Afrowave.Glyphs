<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:tools="clr-namespace:Tools.FontImport;assembly=Tools" x:Class="Editor.Consolonia.UnicodeRangeWizardWindow" x:DataType="tools:UnicodeRangeWizardViewModel" Title="Unicode Range Wizard" Width="60" Height="20"><Grid RowDefinitions="Auto,Auto,*,Auto"><StackPanel Grid.Row="0" Margin="1"><TextBlock Text="Unicode Range Wizard" /><TextBlock Text="Edit glyphs sequentially" /></StackPanel><Grid Grid.Row="1" Margin="1" ColumnDefinitions="Auto,*,Auto,*,Auto"><TextBlock Text="Start:" VerticalAlignment="Center" Grid.Column="0" /><TextBox Text="{Binding StartCodePoint}" Width="8" Margin="1,0" Grid.Column="1" /><TextBlock Text="End:" VerticalAlignment="Center" Grid.Column="2" Margin="1,0,0,0" /><TextBox Text="{Binding EndCodePoint}" Width="8" Margin="1,0" Grid.Column="3" /><Button Content="Start" Click="OnStart" Grid.Column="4" Margin="1,0,0,0" /></Grid><Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="1"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Grid.Row="0" Text="{Binding CurrentCharDisplay}" Margin="1" HorizontalAlignment="Center" /><Border Grid.Row="1" Name="GlyphPreviewBorder" Margin="1" /><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="1"><Button Content="Edit" Click="OnEdit" Margin="1,0" /><Button Content="Clear" Click="OnClear" Margin="1,0" /></StackPanel></Grid></Border><Grid Grid.Row="3" Margin="1" ColumnDefinitions="Auto,*,Auto"><TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Grid.Column="0" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="2"><Button Content="Prev" Command="{Binding PreviousCommand}" Margin="1,0" /><Button Content="Skip" Command="{Binding SkipCommand}" Margin="1,0" /><Button Content="Save" Command="{Binding SaveCommand}" Margin="1,0" /><Button Content="Close" Click="OnClose" Margin="1,0" /></StackPanel></Grid></Grid></Window>
