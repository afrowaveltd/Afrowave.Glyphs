<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:console="https://github.com/jinek/consolonia"
        xmlns:local="clr-namespace:Editor.Consolonia"
        x:Class="Editor.Consolonia.MainWindow"
        RequestedThemeVariant="Dark"
        Title="Consolonia">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
        <TextBlock Text="Afrowave Glyph Editor (Consolonia)" />
        <Button Content="_Import Font…" Command="{Binding StartImportCommand}" />
        <Button Content="_Exit" Click="OnExit" />
    </StackPanel>
</Window>
