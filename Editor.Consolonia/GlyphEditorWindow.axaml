<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Editor.Consolonia"
        x:Class="Editor.Consolonia.GlyphEditorWindow"
        x:CompileBindings="False"
        Width="100" Height="30"
        Title="Glyph editor"
        Focusable="True">

  <StackPanel Spacing="1">
    <TextBlock Text="{Binding GridText}" />
    <TextBlock Text="{Binding HelpText}" Opacity="0.8" />
  </StackPanel>
</Window>
