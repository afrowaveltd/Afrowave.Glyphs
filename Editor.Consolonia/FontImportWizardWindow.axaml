<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="clr-namespace:Tools.FontImport;assembly=Tools"
        x:Class="Editor.Consolonia.FontImportWizardWindow"
        x:CompileBindings="False"
        Width="100" Height="30"
        Title="Import font">

  <StackPanel Spacing="1">
    <TextBlock Text="Font file path (.ttf or .otf):"/>
    <TextBox Name="FontPathInput" 
             Text="{Binding FontPath}" 
             Watermark="e.g., C:\Windows\Fonts\arial.ttf" 
             Width="90" />

    <TextBlock Text="Common paths: Windows: C:\Windows\Fonts\  Linux: /usr/share/fonts/truetype/  macOS: /System/Library/Fonts/"
               Foreground="Gray"
               FontSize="9"
               TextWrapping="Wrap"
               Margin="0,0,0,1"/>

    <TextBlock Text="Pack (e.g. 8x16):"/>
    <TextBox Text="{Binding PackId}" />

    <TextBlock Text="Size preset:"/>
    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding GlyphSize}"/>

    <TextBlock Text="Range start (decimal):"/>
    <TextBox Text="{Binding RangeStart}" />

        <TextBlock Text="Range end (decimal):"/>
        <TextBox Text="{Binding RangeEnd}" />

        <CheckBox IsChecked="{Binding OverwriteExisting}" Content="Overwrite existing" />

        <TextBlock Text="Current:"/>
        <TextBlock Text="{Binding CurrentGlyphIdText}" />
        <TextBlock Text="{Binding ProgressText}" />
        <TextBlock Text="{Binding CurrentChar}" />

        <TextBlock Opacity="0.8" Text="Tip: editor opens on load. Enter/N accept, K skips." />

        <TextBlock Text="Status:"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="1">
          <Button Content="Import Range" Command="{Binding ImportRangeCommand}" />
          <Button Content="Import All" Command="{Binding ImportAllCommand}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="1">
          <Button Content="Start" Command="{Binding StartCommand}" />
          <Button Content="Prev" Command="{Binding PreviousCommand}" />
          <Button Content="Skip" Command="{Binding SkipCommand}" />
          <Button Content="Next (Save)" Command="{Binding NextCommand}" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Close" Command="{Binding FinishCommand}" />
        </StackPanel>
      </StackPanel>
    </Window>
