<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tools="clr-namespace:Tools;assembly=Tools" x:Class="Editor.Avalonia.GlyphEditorWindow" Width="400" Height="300" Title="Glyph Editor" Focusable="True" x:DataType="tools:GlyphEditorViewModel"><StackPanel Spacing="10" Margin="10"><TextBlock Text="{Binding GridText}" FontFamily="Consolas" /><TextBlock Text="{Binding HelpText}" Opacity="0.7" FontSize="11" /></StackPanel></Window>
