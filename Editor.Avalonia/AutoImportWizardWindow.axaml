<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Tools.FontImport;assembly=Tools" x:Class="Editor.Avalonia.AutoImportWizardWindow" x:DataType="vm:AutoImportWizardViewModel" Title="Auto Import Font" Width="600" Height="400" WindowStartupLocation="CenterOwner"><Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20"><StackPanel Grid.Row="0" Spacing="10"><TextBlock Text="Automatic Font Import" FontSize="18" FontWeight="Bold"/><TextBlock Text="Import all available glyphs from the selected font file." TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Margin="0,20,0,20" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="15"><ScrollViewer><StackPanel Spacing="10"><TextBlock Text="Progress:" FontWeight="SemiBold"/><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="24"/><TextBlock Text="{Binding Status}" Foreground="Blue"/><TextBlock Text="{Binding CurrentRangeText}"/><StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10,0,0"><StackPanel><TextBlock Text="Imported:" Foreground="Green"/><TextBlock Text="{Binding ImportedCount}" FontSize="24" FontWeight="Bold"/></StackPanel><StackPanel><TextBlock Text="Skipped:" Foreground="Orange"/><TextBlock Text="{Binding SkippedCount}" FontSize="24" FontWeight="Bold"/></StackPanel></StackPanel></StackPanel></ScrollViewer></Border><Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8" Margin="0,0,0,20"><TextBlock Text="Font File:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/><TextBox Text="{Binding FontPath}" IsReadOnly="True" Grid.Row="0" Grid.Column="1"/><TextBlock Text="Pack ID:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/><TextBox Text="{Binding PackId}" Grid.Row="1" Grid.Column="1"/><TextBlock Text="Glyph Size:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/><TextBlock Text="{Binding GlyphSizeText}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1"/></Grid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Name="StartButton" Content="Start Import" Click="OnStart" MinWidth="120" Padding="10,5"/><Button Name="CancelButton" Content="Close" Click="OnCancel" MinWidth="120" Padding="10,5"/></StackPanel></Grid></Window>
