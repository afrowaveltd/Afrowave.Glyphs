<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="clr-namespace:Tools.FontImport;assembly=Tools"
        x:Class="Editor.Avalonia.FontImportWizardWindow"
        Width="750" Height="550"
        Title="Import Font Glyphs"
        x:DataType="tools:FontImportWizardViewModel"
        Background="{DynamicResource BackgroundBrush}">

  <Border Padding="16" Background="{DynamicResource BackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*" RowSpacing="12">

    <Border Grid.Row="0" 
            Padding="12" 
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            CornerRadius="6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Font:" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FontPath}" Watermark="Select .ttf/.otf" BorderThickness="1"/>
        <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Command="{Binding PickFontCommand}" Padding="8,6" BorderThickness="1"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Pack:" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PackId}" BorderThickness="1"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Size:" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Width="140" ItemsSource="{Binding Presets}" SelectedItem="{Binding GlyphSize}" BorderThickness="1"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" 
            Padding="12" 
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1"
            CornerRadius="6">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontWeight="Bold" Text="Range" Foreground="{DynamicResource TextPrimaryBrush}"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <TextBlock VerticalAlignment="Center" Text="Start:" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBox Width="90" Text="{Binding RangeStart}" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock VerticalAlignment="Center" Text="End:" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBox Width="90" Text="{Binding RangeEnd}" BorderThickness="1"/>
        </StackPanel>

        <CheckBox Grid.Row="2" Grid.ColumnSpan="2" IsChecked="{Binding OverwriteExisting}" Content="Overwrite existing glyphs" Margin="0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" FontWeight="Bold" Text="Current" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
          <TextBlock Text="{Binding CurrentGlyphIdText}" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Opacity="0.7" Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock FontSize="26" Text="{Binding CurrentChar}" Foreground="{DynamicResource PrimaryBrush}"/>
          <TextBlock Opacity="0.7" Text="Edit glyph in the main editor and press Next to save." Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
          <TextBlock Text="Status:" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
        <Button Content="📥 Import Range" 
                Command="{Binding ImportRangeCommand}" 
                ToolTip.Tip="Automatically import all glyphs in range" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button Content="🌍 Import All" 
                Command="{Binding ImportAllCommand}" 
                ToolTip.Tip="Import all glyphs that exist in the font (0-65535)" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Start" 
                Command="{Binding StartCommand}" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button Content="Previous" 
                Command="{Binding PreviousCommand}" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button Content="Skip" 
                Command="{Binding SkipCommand}" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button Content="Next (Save)" 
                Command="{Binding NextCommand}" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button Content="Cancel" 
                Command="{Binding CancelCommand}" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Button Content="Close" 
                Command="{Binding FinishCommand}" 
                Padding="10,6" 
                BorderThickness="1"
                Foreground="{DynamicResource TextPrimaryBrush}"/>
      </StackPanel>
          </Grid>

          </Grid>
        </Border>
      </Window>
